# macOS Finder metadata
.DS_Store

# fish shell machine-local generated state
fish/fish_variables

# machine-specific fish overrides, never shared
fish/conf.d/99-local.fish

# macOS-only app state
raycast/

# herdr-app: the app rewrites its shipped layouts, mods, type files and state on
# every start, so only the personal clones, settings and their docs are tracked
herdr-app/*
!herdr-app/docs/
!herdr-app/settings.json
!herdr-app/layouts/
herdr-app/layouts/*
!herdr-app/layouts/cards.json
!herdr-app/mods/
herdr-app/mods/*
!herdr-app/mods/spaces-cards/
!herdr-app/mods/agents-context/
herdr-app/mods/*/*.d.ts
herdr-app/mods/*/jsconfig.json

# retired: not cross-platform, kept locally but no longer pushed
ghostty/
zed/

# gh: account-bound, differs between work and personal machines
gh/

# machine-local runtime state, regenerated by the tools themselves
homebrew/
hunk/

# fish completions are installed by the tools themselves: OrbStack symlinks
# docker/kubectl/orbctl into /Applications, bun writes its own, etc. They are
# machine- and OS-specific, so tracking them ships dangling symlinks to Linux.
# fisher's completion is plugin-managed like the vendored pure files, so it stays.
fish/completions/*
!fish/completions/fisher.fish

# lanternhall: private-term denylist, holds the very names it exists to keep out of git
lanternhall/
